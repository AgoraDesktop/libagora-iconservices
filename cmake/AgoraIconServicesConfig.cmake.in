@PACKAGE_INIT@

# Consume Icon Services (libagora-iconservices), Agora's Icon Services.
#
# THREE DEPENDENCIES, BECAUSE BOTH ARE IN THE INTERFACE: a generic icon is chosen by UTI (Launch Services)
# and the raster handed back is a `CGImageRef` (Core Graphics). A consumer reaches both itself, so both are
# found here.

include(CMakeFindDependencyMacro)

find_dependency(CoreFoundation CONFIG)
find_dependency(AgoraDrawing CONFIG)
find_dependency(AgoraLaunchServices CONFIG)

if(CMAKE_C_COMPILER_ID STREQUAL "GNU")
  message(FATAL_ERROR
    "libagora-iconservices' interface brings Core Foundation's headers, which need -fblocks. This tree "
    "builds with clang; configure with -DCMAKE_C_COMPILER=/usr/bin/clang-19.")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AgoraIconServicesTargets.cmake")

check_required_components(AgoraIconServices)
